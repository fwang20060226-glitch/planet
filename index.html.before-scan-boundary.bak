<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Street Walk</title>
  <script src="https://aframe.io/releases/1.8.0/aframe.min.js"></script>
  <script>
// Template structure: obstacles register themselves; the player handles blocking.
AFRAME.registerComponent('obstacle', {
  schema: {
    width: {type: 'number', default: 0.3},
    depth: {type: 'number', default: 100}
  },
  init: function () {
    this.center = new AFRAME.THREE.Vector3();
    const scene = this.el.sceneEl;
    scene.obstacles = scene.obstacles || [];
    scene.obstacles.push(this);
  },
  remove: function () {
    const list = this.el.sceneEl.obstacles || [];
    const index = list.indexOf(this);
    if (index !== -1) list.splice(index, 1);
  }
});

// Sweep each ground-plane axis against the box expanded by the player's radius.
// Checking the full step prevents a thin wall being skipped at low frame rates.
function slideAlongWalls(previous, desired, boxes) {
  const result = {x: previous.x, z: previous.z};
  for (const axis of ['x', 'z']) {
    const other = axis === 'x' ? 'z' : 'x';
    let end = desired[axis];
    for (const box of boxes) {
      if (result[other] <= box[other][0] || result[other] >= box[other][1]) continue;
      const low = box[axis][0];
      const high = box[axis][1];
      if (result[axis] <= low && end > low) end = low;
      else if (result[axis] >= high && end < high) end = high;
      else if (result[axis] > low && result[axis] < high) {
        end = result[axis] - low < high - result[axis] ? low : high;
      }
    }
    result[axis] = end;
  }
  return result;
}

AFRAME.registerComponent('simple-collider', {
  schema: {radius: {type: 'number', default: 0.35}},
  init: function () {
    this.world = new AFRAME.THREE.Vector3();
    this.previous = new AFRAME.THREE.Vector3();
    this.el.object3D.updateWorldMatrix(true, false);
    this.el.object3D.getWorldPosition(this.previous);
  },
  // After movement has updated, correct the camera, including its rotated parent.
  tock: function () {
    const player = this.el.object3D;
    player.updateWorldMatrix(true, false);
    player.getWorldPosition(this.world);
    const boxes = (this.el.sceneEl.obstacles || []).map(obstacle => {
      obstacle.el.object3D.updateWorldMatrix(true, false);
      obstacle.el.object3D.getWorldPosition(obstacle.center);
      const halfX = obstacle.data.width / 2 + this.data.radius;
      const halfZ = obstacle.data.depth / 2 + this.data.radius;
      return {
        x: [obstacle.center.x - halfX, obstacle.center.x + halfX],
        z: [obstacle.center.z - halfZ, obstacle.center.z + halfZ]
      };
    });
    const corrected = slideAlongWalls(this.previous, this.world, boxes);
    this.world.x = corrected.x;
    this.world.z = corrected.z;
    this.previous.copy(this.world);
    if (player.parent) player.parent.worldToLocal(this.world);
    player.position.copy(this.world);
    player.updateMatrixWorld(true);
  }
});

  </script>
<script>
  AFRAME.registerComponent('road-particles', {
    schema: {
      startX: { default: -19 },
      startZ: { default: 2 },
      groundY: { default: 0.05 },
      length: { default: 25 },
      width: { default: 3 },
      count: { default: 360 },
      collectRadius: { default: 2.3 }
    },

    init: function () {
      const THREE = AFRAME.THREE;
      const count = this.data.count;

      this.playerPosition = new THREE.Vector3();
      this.remaining = count;
      this.finished = false;
      this.particles = [];

      this.positions = new Float32Array(count * 3);
      this.colors = new Float32Array(count * 3);

      // 柔和的圆形光点贴图。
      const canvas = document.createElement('canvas');
      canvas.width = 64;
      canvas.height = 64;

      const ctx = canvas.getContext('2d');
      const glow = ctx.createRadialGradient(
        32, 32, 0,
        32, 32, 32
      );

      glow.addColorStop(0, 'rgba(255,255,255,1)');
      glow.addColorStop(0.2, 'rgba(255,245,210,0.9)');
      glow.addColorStop(0.55, 'rgba(255,220,150,0.3)');
      glow.addColorStop(1, 'rgba(255,220,150,0)');

      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, 64, 64);

      this.texture = new THREE.CanvasTexture(canvas);

      for (let i = 0; i < count; i++) {
        const progress = i / Math.max(1, count - 1);

        this.particles.push({
          // 从玩家前方开始，沿 X 正方向延伸。
          x: this.data.startX + 3 + progress * this.data.length,
          y: this.data.groundY + 0.25 + Math.random() * 0.9,
          z: this.data.startZ +
             (Math.random() - 0.5) * this.data.width,
          phase: Math.random() * Math.PI * 2,
          collected: false,
          fade: 1
        });

        const p = this.particles[i];
        this.positions[i * 3] = p.x;
        this.positions[i * 3 + 1] = p.y;
        this.positions[i * 3 + 2] = p.z;
      }

      this.geometry = new THREE.BufferGeometry();

      this.geometry.setAttribute(
        'position',
        new THREE.BufferAttribute(this.positions, 3)
          .setUsage(THREE.DynamicDrawUsage)
      );

      this.geometry.setAttribute(
        'color',
        new THREE.BufferAttribute(this.colors, 3)
          .setUsage(THREE.DynamicDrawUsage)
      );

      this.material = new THREE.PointsMaterial({
        size: 0.16,
        map: this.texture,
        transparent: true,
        opacity: 0.85,
        vertexColors: true,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        sizeAttenuation: true
      });

      this.points = new THREE.Points(
        this.geometry,
        this.material
      );

      this.points.frustumCulled = false;
      this.el.setObject3D('particles', this.points);

      // Show guidance first, then replace it with the completion message.
      this.message = document.createElement('div');
      this.message.textContent = 'Follow the floating particles';
      this.message.setAttribute('role', 'status');

      this.message.style.cssText = `
        position: fixed;
        left: 50%;
        top: 12%;
        transform: translate(-50%, -50%);
        padding: 18px 30px;
        border-radius: 16px;
        background: transparent;
        color: #000000;
        font-family: Arial, sans-serif;
        font-size: 26px;
        letter-spacing: 0.5px; font-weight: 500; width: 85%; box-sizing: border-box; text-shadow: 0 1px 4px rgba(255,255,255,0.85);
        text-align: center;
        opacity: 1;
        transition: opacity 1.5s ease;
        pointer-events: none;
        z-index: 1000;
      `;

      document.body.appendChild(this.message);
    },

    tick: function (time, delta) {
      if (this.finished) return;

      const camera = document.querySelector('#camera');
      if (!camera) return;

      camera.object3D.updateWorldMatrix(true, false);
      camera.object3D.getWorldPosition(this.playerPosition);

      // 转入粒子所在实体的坐标系。
      this.el.object3D.updateWorldMatrix(true, false);
      this.el.object3D.worldToLocal(this.playerPosition);

      const seconds = time / 1000;
      const dt = Math.min(delta || 0, 100) / 1000;
      let stillVisible = false;

      this.particles.forEach((p, i) => {
        const index = i * 3;

        if (!p.collected) {
          const dx = this.playerPosition.x - p.x;
          const dz = this.playerPosition.z - p.z;
          const distance = Math.hypot(dx, dz);

          if (distance < this.data.collectRadius) {
            p.collected = true;
            this.remaining--;
          }
        }

        // 收集后稍微升起，并在约半秒内消散。
        if (p.collected) {
          p.fade = Math.max(0, p.fade - dt * 2);
        }

        if (p.fade > 0) {
          stillVisible = true;
        }

        this.positions[index] =
          p.x + Math.sin(seconds * 0.5 + p.phase) * 0.08;

        this.positions[index + 1] =
          p.y +
          Math.sin(seconds * 1.2 + p.phase) * 0.12 +
          (1 - p.fade) * 0.4;

        this.positions[index + 2] =
          p.z + Math.cos(seconds * 0.6 + p.phase) * 0.08;

        const shimmer =
          0.75 + Math.sin(seconds * 1.5 + p.phase) * 0.2;

        const brightness = shimmer * p.fade;

        // 暖白色光点；亮度归零后完全消失。
        this.colors[index] = brightness;
        this.colors[index + 1] = brightness * 0.87;
        this.colors[index + 2] = brightness * 0.6;
      });

      this.geometry.attributes.position.needsUpdate = true;
      this.geometry.attributes.color.needsUpdate = true;

      // 等最后一颗粒子也消散后，才结束体验。
      if (this.remaining === 0 && !stillVisible) {
        this.finished = true;
        this.points.visible = false;
        this.message.textContent = 'Experience complete. Thank you!';
          this.message.style.top = '45%';

        this.el.sceneEl.emit('experience-complete');
      }
    },

    remove: function () {
      this.el.removeObject3D('particles');
      this.geometry?.dispose();
      this.material?.dispose();
      this.texture?.dispose();
      this.message?.remove();
    }
  });
</script>
</head>
<body>
  <a-scene background="color: #dce7ed">
    <a-assets>
      <a-asset-item id="road" src="road2.glb"></a-asset-item>
    </a-assets>
    <a-entity gltf-model="#road"></a-entity>

    <a-entity light="type: hemisphere; color: #ffffff; groundColor: #b8b0a2; intensity: 1"></a-entity>
    <a-entity light="type: directional; color: #fff5e6; intensity: 0.8" position="-3 8 5"></a-entity>
    <a-entity id="right-sun-target" position="-14 0.05 2"></a-entity>
    <a-entity id="right-sun" light="type: directional; color: #fff1d6; intensity: 0.7; target: #right-sun-target" position="-14 8 14"></a-entity>

    <a-box id="left-wall" obstacle="width: 0.3; depth: 100"
      position="-22 2 2" width="0.3" height="4" depth="100" visible="false"></a-box>

    <!-- Preserved starting position and direction. -->
    <a-entity id="rig" position="-9 0.05 12" rotation="0 -90 0">
      <a-camera id="camera" position="-10 0.65 10"
        wasd-controls="acceleration: 12" look-controls simple-collider="radius: 0.35"></a-camera>
    </a-entity>

    <!-- The scanned model ends near X=10.75; particles stop at X=9. -->
    <a-entity id="road-particle-trail"
      road-particles="startX: -19; startZ: 2; groundY: 0.05; length: 25; width: 3; count: 360; collectRadius: 2.3">
    </a-entity>
  </a-scene>
</body>
</html>
