<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Street Walk</title>
  <script src="https://aframe.io/releases/1.8.0/aframe.min.js"></script>
  <script src="street-point-cloud.js"></script>
  <script src="third-walk.js"></script>
  <script>
// Template structure: obstacles register themselves; the player handles blocking.
AFRAME.registerComponent('obstacle', {
  schema: {
    width: {type: 'number', default: 0.3},
    depth: {type: 'number', default: 100}
  },
  init: function () {
    this.center = new AFRAME.THREE.Vector3();
    const scene = this.el.sceneEl;
    scene.obstacles = scene.obstacles || [];
    scene.obstacles.push(this);
  },
  remove: function () {
    const list = this.el.sceneEl.obstacles || [];
    const index = list.indexOf(this);
    if (index !== -1) list.splice(index, 1);
  }
});

// Sweep each ground-plane axis against the box expanded by the player's radius.
// Checking the full step prevents a thin wall being skipped at low frame rates.
function slideAlongWalls(previous, desired, boxes) {
  const result = {x: previous.x, z: previous.z};
  for (const axis of ['x', 'z']) {
    const other = axis === 'x' ? 'z' : 'x';
    let end = desired[axis];
    for (const box of boxes) {
      if (result[other] <= box[other][0] || result[other] >= box[other][1]) continue;
      const low = box[axis][0];
      const high = box[axis][1];
      if (result[axis] <= low && end > low) end = low;
      else if (result[axis] >= high && end < high) end = high;
      else if (result[axis] > low && result[axis] < high) {
        end = result[axis] - low < high - result[axis] ? low : high;
      }
    }
    result[axis] = end;
  }
  return result;
}


// Navigation mask generated from road2.glb's ground triangles (10 cm cells).
// Only ground connected to the starting point is walkable. No extra clearance
// is added around scan edges or obstacles, making narrow passages easier.
// Regenerate this mask if the model or its transform changes.
const SCANNED_GROUND = {"originX":-20.5,"originZ":-2,"step":0.1,"rows":["","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","",""]};
function isOnScannedGround(x, z, secondStage = false) {
  // Stage two adds a broad side-view area outside the scan's irregular edge.
  if (secondStage && x >= -20 && x <= 10.5 && z >= 1.5 && z <= 14) return true;
  const n = SCANNED_GROUND;
  const col = Math.floor((x - n.originX) / n.step);
  const row = Math.floor((z - n.originZ) / n.step);
  return n.rows[row]?.[col] === '1';
}
function slideWithinScan(previous, desired, secondStage = false) {
  const result = {x: previous.x, z: previous.z};
  const dx = desired.x - previous.x, dz = desired.z - previous.z;
  // Substeps prevent crossing narrow gaps even when a frame stalls.
  const steps = Math.ceil(Math.max(Math.abs(dx), Math.abs(dz)) / 0.04);
  if (!Number.isFinite(steps) || steps > 10000) return result;
  for (let i = 0; i < steps; i++) {
    const x = result.x + dx / steps, z = result.z + dz / steps;
    if (isOnScannedGround(x, z, secondStage)) { result.x = x; result.z = z; }
    else {
      if (isOnScannedGround(x, result.z, secondStage)) result.x = x;
      if (isOnScannedGround(result.x, z, secondStage)) result.z = z;
    }
  }
  return result;
}

AFRAME.registerComponent('simple-collider', {
  schema: {radius: {type: 'number', default: 0.35}},
  init: function () {
    this.world = new AFRAME.THREE.Vector3();
    this.previous = new AFRAME.THREE.Vector3();
    this.hasPreviousPosition = false;
  },
  // After movement has updated, correct the camera, including its rotated parent.
  tock: function () {
    const player = this.el.object3D;
    player.updateWorldMatrix(true, false);
    player.getWorldPosition(this.world);
    // Wait until the parent rig and camera have their final starting transforms.
    // Spawning is not a movement step and must never be swept through the boundary.
    if (!this.hasPreviousPosition) {
      this.previous.copy(this.world);
      this.hasPreviousPosition = true;
      return;
    }
    const boxes = (this.el.sceneEl.obstacles || []).map(obstacle => {
      obstacle.el.object3D.updateWorldMatrix(true, false);
      obstacle.el.object3D.getWorldPosition(obstacle.center);
      const halfX = obstacle.data.width / 2 + this.data.radius;
      const halfZ = obstacle.data.depth / 2 + this.data.radius;
      return {
        x: [obstacle.center.x - halfX, obstacle.center.x + halfX],
        z: [obstacle.center.z - halfZ, obstacle.center.z + halfZ]
      };
    });
    const wallCorrected = slideAlongWalls(this.previous, this.world, boxes);
    const stage = document.querySelector('#road-particle-trail')?.components['road-particles']?.stage;
    const secondStage = stage === 'second' || stage === 'third';
    const corrected = slideWithinScan(this.previous, wallCorrected, secondStage);
    this.world.x = corrected.x;
    this.world.z = corrected.z;
    this.previous.copy(this.world);
    if (player.parent) player.parent.worldToLocal(this.world);
    player.position.copy(this.world);
    player.updateMatrixWorld(true);
  }
});

  </script>
<script>
  AFRAME.registerComponent('road-particles', {
    schema: {
      startX: { default: -19 },
      startZ: { default: 2 },
      groundY: { default: 0.05 },
      length: { default: 25 },
      width: { default: 3 },
      count: { default: 3000 },
      collectRadius: { default: 2.3 }
    },

    init: function () {
      const THREE = AFRAME.THREE;
      const count = this.data.count;

      this.playerPosition = new THREE.Vector3();
      this.remaining = count;
      this.finished = false;
      this.stage = 'first';
      this.startPose = {rigPosition: '-9 0.05 12', rigRotation: '0 -90 0', cameraPosition: '-10 0.45 10'};
      this.onContinueKey = event => {
        if (event.code !== 'Space' || event.repeat || this.stage !== 'awaiting-second') return;
        const target = event.target;
        if (target?.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target?.tagName || '')) return;
        event.preventDefault();
        this.enterSecondStage();
      };
      window.addEventListener('keydown', this.onContinueKey);
      this.particles = [];

      this.positions = new Float32Array(count * 3);
      this.colors = new Float32Array(count * 3);
      this.sizes = new Float32Array(count);
      this.alphas = new Float32Array(count);
      this.palette = ['#EEE5D3', '#D8D2B9', '#A2B6A0', '#B9B79C', '#C49A86', '#E2BA9B']
        .map(hex => new THREE.Color(hex));
      this.gradientColor = new THREE.Color();
      this.colorProgress = 0;

      // 柔和的圆形光点贴图。
      const canvas = document.createElement('canvas');
      canvas.width = 64;
      canvas.height = 64;

      const ctx = canvas.getContext('2d');
      const glow = ctx.createRadialGradient(
        32, 32, 0,
        32, 32, 32
      );

      glow.addColorStop(0, 'rgba(255,255,255,1)');
      glow.addColorStop(0.3, 'rgba(255,255,255,0.95)');
      glow.addColorStop(0.65, 'rgba(255,255,255,0.25)');
      glow.addColorStop(1, 'rgba(255,255,255,0)');

      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, 64, 64);

      this.texture = new THREE.CanvasTexture(canvas);

      for (let i = 0; i < count; i++) {
        const sample = i / Math.max(1, count - 1);
        // Smoothly increase density along the route: the end is 5x denser.
        // Inverse CDF of density proportional to (1 + 4 * progress).
        const progress = (Math.sqrt(1 + 24 * sample) - 1) / 4;

        this.particles.push({
          // 从玩家前方开始，沿 X 正方向延伸。
          x: this.data.startX + 3 + progress * this.data.length,
          // Fill the air from near the scanned pavement up through eye level.
          // World-space Y; retain clearance for the 0.12-unit vertical drift.
          y: -1.1 + Math.random() * 2.3,
          z: this.data.startZ +
             (Math.random() - 0.5) * this.data.width,
          phase: Math.random() * Math.PI * 2,
          collected: false,
          fade: 1
        });

        const p = this.particles[i];
        // Persistent variation keeps neighbouring particles from becoming identical.
        p.colorOffset = (Math.random() - 0.5) * 0.24;
        const color = this.palette[0];
        this.colors.set([color.r, color.g, color.b], i * 3);
        this.sizes[i] = (0.035 + Math.random() * 0.035) / 0.05;
        this.alphas[i] = 1;
        this.positions[i * 3] = p.x;
        this.positions[i * 3 + 1] = p.y;
        this.positions[i * 3 + 2] = p.z;
      }

      this.geometry = new THREE.BufferGeometry();

      this.geometry.setAttribute(
        'position',
        new THREE.BufferAttribute(this.positions, 3)
          .setUsage(THREE.DynamicDrawUsage)
      );

      this.geometry.setAttribute(
        'color',
        new THREE.BufferAttribute(this.colors, 3)
          .setUsage(THREE.DynamicDrawUsage)
      );

      this.geometry.setAttribute('particleSize', new THREE.BufferAttribute(this.sizes, 1));
      this.geometry.setAttribute('particleAlpha', new THREE.BufferAttribute(this.alphas, 1)
        .setUsage(THREE.DynamicDrawUsage));

      this.material = new THREE.PointsMaterial({
        size: 0.05,
        map: this.texture,
        transparent: true,
        opacity: 1,
        vertexColors: true,
        blending: THREE.NormalBlending,
        depthWrite: false,
        sizeAttenuation: true
      });

      // Retain PointsMaterial's perspective sizing and color management, with
      // individual sizes and alpha so collected points fade without turning black.
      this.material.onBeforeCompile = shader => {
        shader.vertexShader = 'attribute float particleSize; attribute float particleAlpha; varying float vParticleAlpha;\n' + shader.vertexShader;
        shader.vertexShader = shader.vertexShader.replace('gl_PointSize = size;',
          'gl_PointSize = size * particleSize; vParticleAlpha = particleAlpha;');
        shader.fragmentShader = 'varying float vParticleAlpha;\n' + shader.fragmentShader;
        shader.fragmentShader = shader.fragmentShader.replace('#include <premultiplied_alpha_fragment>',
          'gl_FragColor.a *= vParticleAlpha;\n#include <premultiplied_alpha_fragment>');
      };
      this.material.customProgramCacheKey = () => 'street-particles-soft-v1';

      this.points = new THREE.Points(
        this.geometry,
        this.material
      );

      this.points.frustumCulled = false;
      this.el.setObject3D('particles', this.points);

      // Show guidance first, then replace it with the completion message.
      this.message = document.createElement('div');
      this.message.textContent = 'Follow the floating particles';
      this.message.setAttribute('role', 'status');

      this.message.style.cssText = `
        position: fixed;
        left: 50%;
        top: 12%;
        transform: translate(-50%, -50%);
        padding: 18px 30px;
        border-radius: 16px;
        background: rgba(16, 33, 66, 0.94);
        border: 1px solid rgba(244, 206, 104, 0.55);
        box-shadow: 0 6px 24px rgba(5, 13, 34, 0.35);
        backdrop-filter: blur(8px);
        max-width: 760px;
        line-height: 1.5;
        color: #FFF0C2;
        font-family: Arial, sans-serif;
        font-size: 26px;
        letter-spacing: 0.5px; font-weight: 500; width: 85%; box-sizing: border-box; text-shadow: none;
        text-align: center;
        opacity: 1;
        transition: opacity 1.5s ease;
        pointer-events: none;
        z-index: 1000;
      `;

      document.body.appendChild(this.message);
    },

    tick: function (time, delta) {
      if (this.finished) return;

      const camera = document.querySelector('#camera');
      if (!camera) return;

      camera.object3D.updateWorldMatrix(true, false);
      camera.object3D.getWorldPosition(this.playerPosition);

      // 转入粒子所在实体的坐标系。
      this.el.object3D.updateWorldMatrix(true, false);
      this.el.object3D.worldToLocal(this.playerPosition);

      const seconds = time / 1000;
      const dt = Math.min(delta || 0, 100) / 1000;
      // Position-driven gradient, smoothed over time; walking back reverses it.
      const routeProgress = Math.max(0, Math.min(1,
        (this.playerPosition.x - this.data.startX) / (this.data.length + 3)));
      this.colorProgress += (routeProgress - this.colorProgress) * (1 - Math.exp(-dt * 3));


      this.particles.forEach((p, i) => {
        const index = i * 3;

        if (!p.collected) {
          const dx = this.playerPosition.x - p.x;
          const dz = this.playerPosition.z - p.z;
          const distance = Math.hypot(dx, dz);

          if (distance < this.data.collectRadius) {
            p.collected = true;
            this.remaining--;
          }
        }

        // 收集后稍微升起，并在约半秒内消散。
        if (p.collected) {
          p.fade = Math.max(0, p.fade - dt * 2);
        }


        this.positions[index] =
          p.x + Math.sin(seconds * 0.5 + p.phase) * 0.08;

        this.positions[index + 1] =
          p.y +
          Math.sin(seconds * 1.2 + p.phase) * 0.12 +
          (1 - p.fade) * 0.4;

        this.positions[index + 2] =
          p.z + Math.cos(seconds * 0.6 + p.phase) * 0.08;

        const shimmer =
          0.93 + Math.sin(seconds * 1.5 + p.phase) * 0.07;

        const brightness = shimmer * p.fade;

        // Blend a six-color palette using actual player position and each point's tint.
        const colorT = Math.max(0, Math.min(1, this.colorProgress + p.colorOffset));
        const palettePosition = colorT * (this.palette.length - 1);
        const paletteIndex = Math.min(this.palette.length - 2, Math.floor(palettePosition));
        const blend = palettePosition - paletteIndex;
        this.gradientColor.copy(this.palette[paletteIndex])
          .lerp(this.palette[paletteIndex + 1], blend * blend * (3 - 2 * blend));
        this.colors[index] = this.gradientColor.r;
        this.colors[index + 1] = this.gradientColor.g;
        this.colors[index + 2] = this.gradientColor.b;
        // Collection still fades alpha, independently of the changing hue.
        this.alphas[i] = brightness;
      });

      this.geometry.attributes.position.needsUpdate = true;
      this.geometry.attributes.particleAlpha.needsUpdate = true;
      this.geometry.attributes.color.needsUpdate = true;

      // 收集达到总数的 85% 即触发结束反馈，无需收集剩余粒子。
      if (this.particles.length - this.remaining >= Math.ceil(this.particles.length * 0.85)) {
        this.finished = true;
        this.points.visible = false;
        this.stage = 'awaiting-second';
        this.message.textContent = 'Watch the street come into particles.\nPress SPACE to begin the second walk.';
        this.message.style.whiteSpace = 'pre-line';
        this.message.style.top = '45%';
        const camera = document.querySelector('#camera');
        if (camera) {
          this.movementWasEnabled = camera.getAttribute('wasd-controls').enabled !== false;
          camera.setAttribute('wasd-controls', 'enabled', false);
          camera.components['wasd-controls']?.velocity?.set(0, 0, 0);
        }
        this.el.sceneEl.emit('stage-one-complete', {collected: this.particles.length - this.remaining});
      }
    },

    enterSecondStage: async function () {
      if (this.stage !== 'awaiting-second') return;
      const camera = document.querySelector('#camera');
      const rig = document.querySelector('#rig');
      if (!camera || !rig) return;
      this.stage = 'loading-second';
      this.message.textContent = 'Preparing the particle street…';
      try {
        const cloud = document.querySelector('#street-model')?.components['street-point-cloud'];
        if (!cloud) throw new Error('Point cloud component unavailable');
        await cloud.activate();
      } catch (error) {
        console.error('Could not prepare second walk:', error);
        this.stage = 'awaiting-second';
        this.message.textContent = 'Could not load the particle street. Press SPACE to retry.';
        return;
      }
      this.stage = 'second';
      rig.setAttribute('position', this.startPose.rigPosition);
      rig.setAttribute('rotation', this.startPose.rigRotation);
      camera.setAttribute('position', this.startPose.cameraPosition);
      camera.setAttribute('rotation', '0 0 0');
      const look = camera.components['look-controls'];
      if (look?.yawObject) look.yawObject.rotation.y = 0;
      if (look?.pitchObject) look.pitchObject.rotation.x = 0;
      const movement = camera.components['wasd-controls'];
      movement?.velocity?.set(0, 0, 0);
      if (movement?.keys) movement.keys = {};
      // Teleportation must not be treated as walking across the collision map.
      const collider = camera.components['simple-collider'];
      if (collider) collider.hasPreviousPosition = false;
      rig.object3D.updateWorldMatrix(true, true);
      camera.setAttribute('wasd-controls', 'enabled', this.movementWasEnabled !== false);
      this.message.textContent = 'Watch the street come into particles.';
      this.message.style.top = '12%';
      // Stage two uses the same scene and background. Its visual effect can hook here.
      this.el.sceneEl.emit('stage-two-start');
    },

    enterThirdStage: function () {
      if (this.stage !== 'second') return false;
      const camera = document.querySelector('#camera');
      const rig = document.querySelector('#rig');
      if (!camera || !rig) return false;
      this.stage = 'third';
      rig.setAttribute('position', this.startPose.rigPosition);
      rig.setAttribute('rotation', this.startPose.rigRotation);
      camera.setAttribute('position', this.startPose.cameraPosition);
      camera.setAttribute('rotation', '0 0 0');
      const look = camera.components['look-controls'];
      if (look?.yawObject) look.yawObject.rotation.y = 0;
      if (look?.pitchObject) look.pitchObject.rotation.x = 0;
      const movement = camera.components['wasd-controls'];
      movement?.velocity?.set(0, 0, 0);
      // Keep physically held movement keys across this automatic transition.
      // Teleportation must not be treated as walking across the collision map.
      const collider = camera.components['simple-collider'];
      if (collider) collider.hasPreviousPosition = false;
      rig.object3D.updateWorldMatrix(true, true);
      camera.setAttribute('wasd-controls', 'enabled', true);
      camera.setAttribute('look-controls', 'enabled', true);
      // A-Frame accepts walking keys only when the document body owns focus.
      document.activeElement?.blur?.();
      this.message.textContent = 'Does this scene remind you of anything?\nWalk forward with W / arrow keys. Drag the mouse to look around.';
      this.message.style.top = '12%';
      this.el.sceneEl.emit('stage-three-start');
      return true;
    },

    remove: function () {
      window.removeEventListener('keydown', this.onContinueKey);
      this.el.removeObject3D('particles');
      this.geometry?.dispose();
      this.material?.dispose();
      this.texture?.dispose();
      this.message?.remove();
    }
  });
</script>
</head>
<body>
  <a-scene side-view-guide background="color: #091426" fog="type: linear; color: #091426; near: 8; far: 65">
    <a-assets>
      <a-asset-item id="road" src="road2.glb"></a-asset-item>
    </a-assets>
    <a-entity id="street-model" gltf-model="#road" street-point-cloud third-walk></a-entity>

    <a-entity light="type: hemisphere; color: #A2BDEB; groundColor: #94764B; intensity: 0.85"></a-entity>
    <a-entity light="type: directional; color: #86A9E3; intensity: 0.45" position="-3 8 5"></a-entity>
    <a-entity id="right-sun-target" position="-14 0.05 2"></a-entity>
    <a-entity id="right-sun" light="type: directional; color: #FFD477; intensity: 1.2; target: #right-sun-target" position="-14 8 14"></a-entity>

<!-- Preserved starting position and direction. -->
    <a-entity id="rig" position="-9 0.05 12" rotation="0 -90 0">
      <a-camera id="camera" position="-10 0.45 10"
        wasd-controls="acceleration: 12" look-controls simple-collider="radius: 0.1"></a-camera>
    </a-entity>

    <!-- The scanned model ends near X=10.75; particles stop at X=9. -->
    <a-entity id="road-particle-trail"
      road-particles="startX: -19; startZ: 2; groundY: 0.05; length: 25; width: 3; count: 3000; collectRadius: 2.3">
    </a-entity>
  </a-scene>
</body>
</html>
